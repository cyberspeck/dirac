#!/bin/sh
# Refuse any push whose commits fail scripts/privacy-lint.py (private terms, trailers, private tools).
# Range per ref: everything not already in upstream. Install: ln -s ../../scripts/pre-push .git/hooks/pre-push
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # branch delete
	base=$(git merge-base "$local_sha" upstream/master) || { echo "pre-push: no merge-base with upstream/master for $local_ref" >&2; exit 1; }
	python3 scripts/privacy-lint.py "$base" "$local_sha" >&2 || { echo "pre-push: refused $local_ref -> $remote_ref" >&2; status=1; }
done
exit $status
